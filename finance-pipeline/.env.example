# Market Data Worker — API Keys
# ================================
# Get these API keys from the respective services.
# All are FREE.

# TCMB (Turkish Central Bank) — EVDS API
# Register at: https://evds2.tcmb.gov.tr/
TCMB_API_KEY=

# TÜİK (Turkish Statistical Institute) — Turbo API
# Register at: https://servis.tableapi.gov.tr/
TUIK_API_KEY=

# FRED (Federal Reserve Economic Data)
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ExchangeRate-API — Free tier (1500 req/month)
# No key needed for free tier: https://open.er-api.com/
# For paid tier: https://www.exchangerate-api.com/

# CoinGecko — No key needed for free tier
# https://www.coingecko.com/en/api

# Yahoo Finance — No key needed (via yfinance library)
# https://pypi.org/project/yfinance/

# Database (shared with other services)
DATABASE_URL=postgresql://admin:secret_password@postgres_db:5432/finance_platform
